@startuml A3-C4-niveau2-conteneurs
' Révision phase 2 :
'  - Planifium remplace le Répertoire des cours et programmes.
'  - Moteur de règles, Ordonnanceur et Service d'import étaient des modules du même déploiement
'    Spring Boot : au sens C4, ce sont des composants. Ils sont détaillés au niveau 3 (B1).
'  - Planifium est appelé par l'API, jamais par le navigateur (CORS, cache, tolérance aux pannes).
!include <C4/C4_Container>
skinparam defaultFontName DejaVu Sans
LAYOUT_TOP_DOWN()
title Niveau 2 — Conteneurs du système Boussole (révisé en phase 2)

Person(etu, "Personne étudiante", "")
Person(enc, "Personne qui encadre /\nlaboratoire / organisation", "")
Person(cp, "Conseil de programme", "")

System_Boundary(b, "Boussole") {
  Container(spa, "Application web", "React + TypeScript (SPA)", "Offre, plan de session, vue multi-sessions, demandes, alertes.")
  Container(api, "API applicative", "Java 21 / Spring Boot", "Planification, vérification des règles, cycle des demandes, échéances, accès aux sources externes et cache.")
  ContainerDb(bd, "Base de données", "PostgreSQL", "Profils, dossiers, plans, offres encadrées, demandes, échéances, historique, copie datée des réponses externes.")
}

System_Ext(plan, "Planifium", "Cours, exigences, programmes, horaires")
System_Ext(syn, "Synchro", "Dossier étudiant")
System_Ext(cal, "Calendrier universitaire", "Dates limites")
System_Ext(auth, "Authentification UdeM", "SSO")
System_Ext(mail, "Service de courriel", "SMTP")

Rel(etu, spa, "Utilise", "HTTPS")
Rel(enc, spa, "Publie et répond", "HTTPS")
Rel(cp, spa, "Approuve", "HTTPS")
Rel(spa, api, "Requêtes et réponses (plan, offre, demandes, verdicts)", "JSON / HTTPS (REST)")
Rel(spa, auth, "Redirige pour connexion", "OIDC")
Rel(api, auth, "Valide le jeton d'accès", "OIDC / JWT")
Rel(api, bd, "Lit et écrit les objets conservés", "SQL / JDBC")
Rel(api, plan, "À la demande : GET cours, programmes, horaires ; POST courseplan/check, progress (copie gardée 24 h)", "JSON / HTTPS")
Rel(api, syn, "Lit le dossier à l'import, avec consentement (interface supposée)", "API REST, lecture seule")
Rel(api, cal, "Importe les dates limites", "iCal / HTTPS, hebdomadaire")
Rel(api, mail, "Envoie rappels et notifications", "SMTP")
@enduml
